---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import LockedNotice from "@components/content/LockedNotice.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    // 開發環境顯示所有文章，生產環境過濾掉 draft 文章
    if (import.meta.env.DEV) return true;
    return data.draft !== true;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;

const isLocked = post.data.locked === true && !import.meta.env.DEV;

let Content: any = null;
let headings: any[] = [];
if (!isLocked) {
  const rendered = await render(post);
  Content = rendered.Content;
  headings = rendered.headings;
}

const ImagePacked = (await import("@components/markdown/ImagePacked.astro"))
  .default;
---

<BlogPost {...post.data} headings={headings}>
  {
    isLocked ? (
      <LockedNotice title={post.data.title} />
    ) : (
      <Content
        components={{
          img: ImagePacked,
        }}
      />
    )
  }
</BlogPost>
