---
import { Lock } from "lucide-react";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div
  class="flex flex-col items-center justify-center text-center py-20 px-6 rounded-2xl border border-neutral-800 bg-neutral-900/40"
>
  <div
    class="w-20 h-20 rounded-full bg-neutral-800/80 flex items-center justify-center mb-6 ring-1 ring-green-500/30 animate-pulse"
  >
    <Lock size={36} className="text-green-500" />
  </div>

  <h2 class="text-2xl font-bold text-white mb-3">Writeup bloqueado</h2>

  <p class="text-neutral-400 max-w-md leading-relaxed">
    Esta máquina sigue <span class="text-green-400 font-semibold">activa</span> en
    Hack The Box. Por política de HTB, el contenido completo se publicará en cuanto
    la máquina sea retirada.
  </p>

  {
    title && (
      <p class="text-neutral-600 text-sm mt-6 font-mono">
        🔒 {title}
      </p>
    )
  }
</div>
