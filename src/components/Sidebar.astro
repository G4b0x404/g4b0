---
import config from "@shConfig";
import AuthorCard from "./widgets/AuthorCard";
import DiscordCard from "./widgets/DiscordCard";
import CheatsheetCard from "./widgets/CheatsheetCard";
---

<!-- Sidebar -->
<aside class="w-full lg:w-95 flex flex-col gap-5">
  <!-- Author card -->
  <AuthorCard
    client:load
    image={config.author.avatarUrl}
    name={config.author.name}
    slug={config.author.name.toLowerCase().replace(/\s+/g, "")}
    description={config.author.bio}
    links={config.author.links}
  />

  <!-- Discord cards -->
  <a
    href="https://discord.gg/58WxDzeJd"
    target="_blank"
    rel="noopener noreferrer"
  >
    <DiscordCard
      client:load
      title="Discord"
      subtitle="¡Únete a la Comunidad!"
      description="Servidor de Discord para compartir writeups y networking en ciberseguridad!"
    />
  </a>

  <!-- Cheatsheets card -->
  <a
    href="https://g4b0.gitbook.io/g4b0-docs"
    target="_blank"
    rel="noopener noreferrer"
  >
    <CheatsheetCard
      client:load
      title="Cheatsheets"
      subtitle="G4b0 Docs"
      description="Mis cheatsheets y apuntes técnicos de pentesting y Active Directory."
    />
  </a>

  <!-- You can add more widgets here, we suggest adding a widget with the shadcn Card component like this: -->
  <!-- <Card className="border border-white/10 rounded-[14px] p-5 relative overflow-hidden" /> -->

  <!-- Never remove this slot, it's for the Table of Contents (ToC) - which will be sticky -->
  <slot />
</aside>
